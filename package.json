    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "@vercel/functions": "3.9.11",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.3",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",

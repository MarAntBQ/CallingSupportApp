# Conexión que usa la aplicación.
# Local (docker compose): la base de desarrollo, sin datos reales.
# Supabase: el pooler en modo transacción, puerto 6543.
DATABASE_URL=postgres://callingsupportapp:callingsupportapp@localhost:5432/callingsupportapp

# Conexión para las migraciones (drizzle-kit).
# Local: la misma que DATABASE_URL.
# Supabase: el Session pooler, puerto 5432 (la conexión directa es solo IPv6
# y Vercel compila por IPv4).
DIRECT_DATABASE_URL=postgres://callingsupportapp:callingsupportapp@localhost:5432/callingsupportapp

# Pruebas de integración (opcional). Una base que se VACÍA en cada corrida: su nombre
# tiene que contener "test". Docker ya la crea. Sin esta variable, esas pruebas se saltan.
TEST_DATABASE_URL=postgres://callingsupportapp:callingsupportapp@localhost:5432/csa_test

# Ambiente lógico de la aplicación: development | staging | demo | production.
# Controla el banner de "datos inventados" (solo en staging/demo). No reemplaza a NODE_ENV.
# Por defecto, development. (La app no se indexa en ningún ambiente: robots.txt bloquea todo.)
APP_ENV=development

# Orígenes extra que pueden hacer POST a la API (opcional, separados por coma). Por defecto solo
# se acepta el propio sitio.
APP_ORIGINS=

# reCAPTCHA (opcional). Si existe la clave secreta, la política de datos (/privacy) nombra a Google
# entre las transferencias internacionales. Sin ella, no lo nombra.
RECAPTCHA_SECRET_KEY=

# Llave para cifrar secretos en la base (por ejemplo, la contraseña SMTP), con AES-256-GCM.
# 64 caracteres hexadecimales. Genérala con: openssl rand -hex 32
# Si cambia, hay que volver a escribir la contraseña SMTP en Configuración.
ENC_KEY=

# Por seguridad, en producción el correo no se conecta a servidores SMTP con dirección interna o
# privada (localhost, 10.x, 192.168.x…). Para probar un build de producción con Mailpit en tu
# máquina, ponla en true. Nunca en una instalación real.
SMTP_ALLOW_PRIVATE_HOSTS=

# Purga diaria (Vercel Cron llama a /api/cron/daily con "Authorization: Bearer <CRON_SECRET>").
# Sin esta variable la ruta responde 401 y no purga. Genérala con: openssl rand -hex 32
CRON_SECRET=

# URL pública de la app (para registrar el webhook de Telegram). En local: http://localhost:3000
APP_URL=

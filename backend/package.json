    "exceljs": "^4.4.0",
    "mysql2": "^3.14.0",
    "nodemailer": "^6.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.21"
